<Window x:Class="GmuLauncher.Views.AboutWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource About_Title}" Width="420" Height="380" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FlowDirection="{DynamicResource AppFlowDirection}" Icon="/Assets/icon.ico">
    <StackPanel Margin="28" VerticalAlignment="Center">
        <Image Source="/Assets/logo.png" Width="90" Height="90" Style="{StaticResource LogoImage}"/>
        <TextBlock Text="Gmu Studios" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
        <TextBlock Text="Gmu Launcher" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
        <TextBlock x:Name="VersionText" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,12"/>
        <TextBlock Text="{DynamicResource About_Text}" TextWrapping="Wrap" TextAlignment="Center"/>
        <TextBlock Text="{DynamicResource About_Disclaimer}" TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0"/>
        <TextBlock Text="{DynamicResource Footer}" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center" Margin="0,18,0,0"/>
    </StackPanel>
</Window>

<UserControl x:Class="GmuLauncher.Views.HomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Gmu Launcher" Style="{StaticResource H1}"/>
            <TextBlock Text="{DynamicResource Home_Instance}" Style="{StaticResource Muted}" Margin="0,16,0,6"/>
            <ComboBox ItemsSource="{Binding State.Instances}" SelectedItem="{Binding State.SelectedInstance}"
                      DisplayMemberPath="Display" MaxWidth="520" HorizontalAlignment="Left" MinWidth="280"/>
            <TextBlock Text="{DynamicResource Home_NoInstance}" Margin="0,6,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State.SelectedInstance}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- سجل التشغيل -->
        <Border Grid.Row="1" Margin="0,16" Background="#0A0C10" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Margin="12,8">
                    <TextBlock Text="{DynamicResource Home_Console}" Style="{StaticResource Muted}" FontWeight="SemiBold"/>
                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="🗑" Padding="8,2" Command="{Binding ClearLogsCommand}"/>
                </DockPanel>
                <ScrollViewer x:Name="LogScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="12,0,12,8">
                    <ItemsControl ItemsSource="{Binding Logs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" FlowDirection="LeftToRight" Foreground="#C9D1D9"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- شريط التشغيل -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource DangerButton}" Content="{DynamicResource Home_Kill}" Command="{Binding KillCommand}" Margin="0,0,10,0" Padding="18,14"/>
            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="{DynamicResource Home_Play}" Command="{Binding PlayCommand}"
                    FontSize="22" Padding="56,14" MinWidth="200"/>
        </Grid>
    </Grid>
</UserControl>

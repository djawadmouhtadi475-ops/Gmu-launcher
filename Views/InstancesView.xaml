<UserControl x:Class="GmuLauncher.Views.InstancesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource Nav_Instances}" Style="{StaticResource H1}"/>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16">
            <StackPanel>
                <TextBlock Text="{DynamicResource Inst_New}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <WrapPanel>
                    <StackPanel Margin="0,0,12,8" Width="220"><TextBlock Text="{DynamicResource Inst_Name}" Style="{StaticResource Muted}"/>
                        <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    <StackPanel Margin="0,0,12,8"><TextBlock Text="{DynamicResource Inst_Type}" Style="{StaticResource Muted}"/>
                        <ComboBox ItemsSource="{Binding VersionTypes}" SelectedItem="{Binding SelectedType}"/></StackPanel>
                    <StackPanel Margin="0,0,12,8"><TextBlock Text="{DynamicResource Inst_Version}" Style="{StaticResource Muted}"/>
                        <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" DisplayMemberPath="Id"/></StackPanel>
                    <StackPanel Margin="0,0,12,8"><TextBlock Text="{DynamicResource Inst_Loader}" Style="{StaticResource Muted}"/>
                        <ComboBox ItemsSource="{Binding Loaders}" SelectedItem="{Binding SelectedLoader}"/></StackPanel>
                    <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource Inst_Create}" Command="{Binding CreateCommand}" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                </WrapPanel>
                <TextBlock Text="{Binding Message}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- البحث والفلترة -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="280" Margin="0,0,10,0" ToolTip="{DynamicResource Inst_Search}"/>
            <ComboBox ItemsSource="{Binding FilterTypes}" SelectedItem="{Binding FilterType}"/>
        </WrapPanel>

        <ListBox Grid.Row="3" ItemsSource="{Binding InstancesView}" SelectedItem="{Binding State.SelectedInstance}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock Style="{StaticResource Muted}"><Run Text="{Binding Loader, Mode=OneWay}"/> · <Run Text="{Binding McVersion, Mode=OneWay}"/> · <Run Text="{Binding VersionType, Mode=OneWay}"/></TextBlock>
                            <TextBlock Text="{Binding LastPlayedText}" Style="{StaticResource Muted}" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{DynamicResource Inst_OpenFolder}" Margin="0,0,6,0" Padding="10,5"
                                    Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                            <Button Content="{DynamicResource Inst_Delete}" Padding="10,5"
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>

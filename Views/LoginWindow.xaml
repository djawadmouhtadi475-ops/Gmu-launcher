<Window x:Class="GmuLauncher.Views.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gmu Launcher" Width="520" Height="680" MinHeight="560" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FlowDirection="{DynamicResource AppFlowDirection}" Icon="/Assets/icon.ico">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24" MaxWidth="440">
            <Image Source="/Assets/logo.png" Width="84" Height="84" Style="{StaticResource LogoImage}"/>
            <TextBlock Text="Gmu Studios" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            <TextBlock Text="{DynamicResource Login_Welcome}" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,2,0,20"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <RadioButton Style="{StaticResource TabButton}" GroupName="m" IsChecked="True" Command="{Binding SetModeCommand}" CommandParameter="ms">
                    <TextBlock Text="Microsoft"/>
                </RadioButton>
                <RadioButton Style="{StaticResource TabButton}" GroupName="m" Command="{Binding SetModeCommand}" CommandParameter="off">
                    <TextBlock Text="{DynamicResource Login_Offline}"/>
                </RadioButton>
            </StackPanel>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <!-- Microsoft -->
                    <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource Login_Microsoft}" Padding="14,12"
                            Command="{Binding MicrosoftLoginCommand}" Visibility="{Binding IsMicrosoftMode, Converter={StaticResource B2V}}"/>
                    <!-- Offline -->
                    <StackPanel Visibility="{Binding IsOfflineMode, Converter={StaticResource B2V}}">
                        <TextBlock Text="{DynamicResource Login_Username}" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" MaxLength="16"/>
                        <TextBlock Text="{DynamicResource Login_OfflineWarn}" TextWrapping="Wrap" Foreground="#F0A500" Margin="0,10"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource Login_Continue}" Command="{Binding OfflineLoginCommand}"/>
                    </StackPanel>

                    <CheckBox Content="{DynamicResource Login_Remember}" IsChecked="{Binding Remember}" Margin="0,14,0,0"/>
                    <ProgressBar IsIndeterminate="True" Margin="0,12,0,0" Height="4" Visibility="{Binding IsBusy, Converter={StaticResource B2V}}"/>
                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- الحسابات المحفوظة (للتبديل السريع) -->
            <TextBlock Text="{DynamicResource Login_Saved}" Style="{StaticResource Muted}" Margin="0,18,0,6"
                       Visibility="{Binding HasSaved, Converter={StaticResource B2V}}"/>
            <ItemsControl ItemsSource="{Binding Saved}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Image Source="{Binding AvatarUrl}" Width="32" Height="32" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Username}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Type}" Style="{StaticResource Muted}" FontSize="11"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="▶" Padding="10,4" Margin="0,0,6,0"
                                        Command="{Binding DataContext.UseSavedCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                <Button Grid.Column="3" Content="✕" Padding="10,4"
                                        Command="{Binding DataContext.RemoveSavedCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{DynamicResource Footer}" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center" Margin="0,24,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Window>

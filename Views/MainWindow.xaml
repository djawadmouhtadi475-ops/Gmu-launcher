<Window x:Class="GmuLauncher.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gmu Launcher" Width="1180" Height="740" MinWidth="720" MinHeight="520" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FlowDirection="{DynamicResource AppFlowDirection}" Icon="/Assets/icon.ico" SizeChanged="OnSizeChanged">
    <Window.DataContext><vm:MainViewModel xmlns:vm="clr-namespace:GmuLauncher.ViewModels"/></Window.DataContext>
    <Window.Resources>
        <!-- النصوص تختفي تلقائياً عندما يضيق العرض (تصميم Responsive) -->
        <Style x:Key="NavLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SideCol" Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- الشريط الجانبي -->
            <Border Background="{StaticResource PanelBrush}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,18,0,14" HorizontalAlignment="Center">
                        <Image Source="/Assets/logo.png" Width="56" Height="56" Style="{StaticResource LogoImage}"/>
                        <TextBlock Style="{StaticResource NavLabel}" Text="Gmu Studios" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,12">
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Command="{Binding NavigateCommand}" CommandParameter="Settings">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="⚙" FontSize="18" Width="30"/><TextBlock Style="{StaticResource NavLabel}" Text="{DynamicResource Nav_Settings}"/></StackPanel>
                        </RadioButton>
                    </StackPanel>
                    <StackPanel>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav" IsChecked="True" Command="{Binding NavigateCommand}" CommandParameter="Home">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="🏠" FontSize="18" Width="30"/><TextBlock Style="{StaticResource NavLabel}" Text="{DynamicResource Nav_Home}"/></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Command="{Binding NavigateCommand}" CommandParameter="Instances">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="📦" FontSize="18" Width="30"/><TextBlock Style="{StaticResource NavLabel}" Text="{DynamicResource Nav_Instances}"/></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Command="{Binding NavigateCommand}" CommandParameter="Mods">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="🧩" FontSize="18" Width="30"/><TextBlock Style="{StaticResource NavLabel}" Text="{DynamicResource Nav_Mods}"/></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Command="{Binding NavigateCommand}" CommandParameter="Packs">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="🎨" FontSize="18" Width="30"/><TextBlock Style="{StaticResource NavLabel}" Text="{DynamicResource Nav_Packs}"/></StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Command="{Binding NavigateCommand}" CommandParameter="Skins">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="👤" FontSize="18" Width="30"/><TextBlock Style="{StaticResource NavLabel}" Text="{DynamicResource Nav_Skins}"/></StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- المحتوى -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                <!-- الحساب الحالي + صورة الـ Skin في الزاوية العلوية -->
                <Border Background="{StaticResource PanelBrush}" Padding="16,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Image Source="{Binding State.Account.AvatarUrl}" Width="36" Height="36" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            <StackPanel Margin="10,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding State.Account.Username}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding State.Account.Type}" Style="{StaticResource Muted}" FontSize="11"/>
                            </StackPanel>
                            <Button Content="{DynamicResource Account_Switch}" Command="{Binding SwitchAccountCommand}" Padding="10,5" Margin="0,0,6,0"/>
                            <Button Content="{DynamicResource Account_Logout}" Command="{Binding LogoutCommand}" Padding="10,5"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ContentControl Grid.Row="1" Content="{Binding CurrentPage}"/>
            </Grid>
        </Grid>

        <!-- حقوق النشر -->
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" Padding="8,6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{DynamicResource Footer}" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>

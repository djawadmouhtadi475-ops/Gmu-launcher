<UserControl x:Class="GmuLauncher.Views.ModsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <DockPanel>
            <TextBlock Text="{DynamicResource Nav_Mods}" Style="{StaticResource H1}"/>
            <ComboBox DockPanel.Dock="Right" HorizontalAlignment="Right" ItemsSource="{Binding State.Instances}" SelectedItem="{Binding State.SelectedInstance}" DisplayMemberPath="Display" MinWidth="240"/>
        </DockPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,10">
            <RadioButton Style="{StaticResource TabButton}" GroupName="modtab" IsChecked="True" Command="{Binding SetTabCommand}" CommandParameter="local"><TextBlock Text="{DynamicResource Mods_Local}"/></RadioButton>
            <RadioButton Style="{StaticResource TabButton}" GroupName="modtab" Command="{Binding SetTabCommand}" CommandParameter="browse"><TextBlock Text="{DynamicResource Mods_Browse}"/></RadioButton>
        </StackPanel>

        <!-- ===== المودات المحلية (Drag &amp; Drop) ===== -->
        <Border Grid.Row="2" x:Name="DropZone" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" Background="Transparent"
                Visibility="{Binding IsLocal, Converter={StaticResource B2V}}">
            <Grid>
                <ListBox ItemsSource="{Binding LocalMods}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Image Grid.Column="1" Source="{Binding Logo}" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <StackPanel Grid.Column="2" Margin="10,0">
                                    <TextBlock FontWeight="SemiBold"><Run Text="{Binding Name, Mode=OneWay}"/> <Run Text="{Binding Version, Mode=OneWay}" Foreground="{StaticResource AccentBrush}"/> <Run Text="{Binding Loader, Mode=OneWay}" Foreground="{StaticResource MutedBrush}"/></TextBlock>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" MaxHeight="20"/>
                                    <TextBlock Text="{Binding Warning}" Foreground="#F0A500" FontSize="12" Visibility="{Binding HasWarning, Converter={StaticResource B2V}}"/>
                                </StackPanel>
                                <Button Grid.Column="3" Content="🗑" Padding="10,5" VerticalAlignment="Center"
                                        Command="{Binding DataContext.DeleteModCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{DynamicResource Mods_Drop}" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- ===== التصفح ===== -->
        <Grid Grid.Row="2" Visibility="{Binding IsBrowse, Converter={StaticResource B2V}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <WrapPanel Margin="0,0,0,10">
                <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}" Margin="0,0,8,6"/>
                <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Width="240" Margin="0,0,8,6" ToolTip="{DynamicResource Mods_Search}"/>
                <ComboBox ItemsSource="{Binding LoaderFilters}" SelectedItem="{Binding LoaderFilter}" Margin="0,0,8,6"/>
                <TextBox Text="{Binding McFilter, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="0,0,8,6" ToolTip="{DynamicResource Mods_McVersion}"/>
                <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource Mods_SearchBtn}" Command="{Binding SearchCommand}" Margin="0,0,0,6"/>
            </WrapPanel>
            <ListBox Grid.Row="1" ItemsSource="{Binding Results}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Image Source="{Binding IconUrl}" Width="48" Height="48"/>
                            <StackPanel Grid.Column="1" Margin="10,0">
                                <TextBlock FontWeight="SemiBold"><Run Text="{Binding Title, Mode=OneWay}"/> <Run Text="{Binding Author, Mode=OneWay}" Foreground="{StaticResource MutedBrush}"/></TextBlock>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" TextWrapping="Wrap" MaxHeight="40"/>
                                <TextBlock Text="{Binding DownloadsText, StringFormat='⬇ {0}'}" Foreground="{StaticResource AccentBrush}" FontSize="12"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="{DynamicResource Mods_Download}" VerticalAlignment="Center"
                                    Command="{Binding DataContext.DownloadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" VerticalAlignment="Top" Visibility="{Binding IsSearching, Converter={StaticResource B2V}}"/>
        </Grid>

        <!-- شريط تقدم التنزيل + إلغاء -->
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <Grid Visibility="{Binding IsDownloading, Converter={StaticResource B2V}}" Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding DownloadName}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding DownloadProgress}"/>
                <Button Grid.Column="2" Content="{DynamicResource Mods_Cancel}" Command="{Binding CancelDownloadCommand}" Margin="10,0,0,0" Padding="10,4"/>
            </Grid>
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#F0A500"/>
        </StackPanel>
    </Grid>
</UserControl>

<UserControl x:Class="GmuLauncher.Views.SkinViewer" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="Host" Background="#12151B" CornerRadius="10" Cursor="SizeWE" MinHeight="320">
        <Viewport3D x:Name="View" ClipToBounds="True" IsHitTestVisible="False">
            <Viewport3D.Camera>
                <PerspectiveCamera Position="0,16,64" LookDirection="0,0,-1" UpDirection="0,1,0" FieldOfView="40"/>
            </Viewport3D.Camera>
            <ModelVisual3D><ModelVisual3D.Content><AmbientLight Color="White"/></ModelVisual3D.Content></ModelVisual3D>
        </Viewport3D>
    </Border>
</UserControl>

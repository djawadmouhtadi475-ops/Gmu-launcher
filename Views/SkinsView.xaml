<UserControl x:Class="GmuLauncher.Views.SkinsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:v="clr-namespace:GmuLauncher.Views">
    <Grid Margin="24">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320" MinWidth="260"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <TextBlock Text="{DynamicResource Nav_Skins}" Style="{StaticResource H1}" Grid.ColumnSpan="2"/>

        <!-- معرض الـ Skins (Grid) -->
        <DockPanel Grid.Row="1" Margin="0,16,16,0">
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource Skins_Import}" Command="{Binding ImportCommand}" Margin="0,0,10,6"/>
                <TextBox Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="0,0,6,6" ToolTip="{DynamicResource Skins_ByName}"/>
                <Button Content="{DynamicResource Skins_ByName}" Command="{Binding ImportByNameCommand}" Margin="0,0,0,6"/>
            </WrapPanel>
            <ListBox ItemsSource="{Binding Skins}" SelectedItem="{Binding SelectedSkin}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="96">
                            <Image Source="{Binding Head}" Width="64" Height="64" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- المعاينة ثلاثية الأبعاد -->
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,16,0,0">
            <v:SkinViewer SkinPath="{Binding SelectedSkin.Path}" Height="360"/>
            <TextBlock Text="{DynamicResource Skins_Hint}" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center" Margin="0,6"/>
            <CheckBox Content="{DynamicResource Skins_Slim}" IsChecked="{Binding Slim}" Margin="0,4,0,8"/>
            <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource Skins_Apply}" Command="{Binding ApplyCommand}"/>
            <Button Content="{DynamicResource Skins_Delete}" Command="{Binding DeleteCommand}" Margin="0,6,0,0"/>
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource B2V}}"/>
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#F0A500" Margin="0,8,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
